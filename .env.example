# Server Port
PORT=3000

# Admin Dashboard Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin#12345

# JWT Secret Key untuk Sesi Dashboard Admin
JWT_SECRET=super_secret_jwt_key_wa_gateway_2026_x89

# External REST API Key (Dipakai oleh Sistem PHP/RFID)
API_KEY=my_secret_api_key_123

# Custom Auth Directory Name
AUTH_DIR=auth_info_baileys

# Webhook Callback URL (Opsional: Dipanggil saat ada pesan WA masuk)
WEBHOOK_URL=

# MySQL Database (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wa_gateway_db

# ── SMTP Email Notifications (Nodemailer) ───────────────────
# Diperlukan untuk notifikasi email aktivasi akun customer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="WhatsApp Gateway" <your_email@gmail.com>
APP_URL=http://localhost:3000

