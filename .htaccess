# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/smkmuth3/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/smkmuth3/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ==============================================================================
# ENTERPRISE WHATSAPP GATEWAY - HIGH PERFORMANCE & CONCURRENCY .HTACCESS
# Dibuat untuk cPanel, Apache, & LiteSpeed Web Server
# ==============================================================================

# ── 1. KEAMANAN: Matikan Directory Browsing (Mencegah intip folder) ───────────
Options -Indexes -MultiViews

# ── 2. KEAMANAN: Blokir Akses Langsung ke File Sensitif & Kredensial ──────────
<FilesMatch "(^\.env|package\.json|package-lock\.json|ecosystem\.config\.cjs|\.git|README\.md)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── 3. REWRITE ENGINE: ROUTING KE PUBLIC & PROXY API ──────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Blokir akses ke folder internal sistem
    RewriteRule ^(\.git|node_modules|src|auth_info_baileys|sessions) - [F,L,NC]

    # B. Otomatis Alihkan HTTP ke HTTPS (Aman untuk Publik / Banyak Orang)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # C. Halaman UTAMA (/) langsung diarahkan ke landing.html
    DirectoryIndex public/landing.html public/index.html index.html
    RewriteRule ^$ public/landing.html [L]
    RewriteRule ^landing/?$ public/landing.html [L]

    # D. Halaman login & dashboard control panel diarahkan ke public/index.html
    RewriteRule ^login/?$ public/index.html [L]
    RewriteRule ^dashboard/?$ public/index.html [L]
    RewriteRule ^panduan/?$ public/panduan.html [L]

    # D. Arahkan file statis (CSS, JS, gambar, PDF) dari folder public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # E. Proxy KHUSUS untuk endpoint /api/ dan WebSocket ke backend Node.js
    # PENTING: Gunakan port 3005 (atau port aktif di server Anda), JANGAN port 3000
    # karena port 3000 di server hosting sudah terpakai oleh aplikasi lain (Next.js).
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^api/(.*)$ ws://127.0.0.1:3005/api/$1 [P,L]

    RewriteRule ^api/(.*)$ http://127.0.0.1:3005/api/$1 [P,L]
</IfModule>

# ── 4. OPTIMASI HIGH TRAFFIC: Kompresi Gzip/Deflate (Hemat Bandwidth) ─────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 5. OPTIMASI BROWSER CACHING: Agar Cepat Dibuka Banyak Orang ────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # CSS, JavaScript & Fonts
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    
    # Images & Media
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # API / JSON & Dynamic HTML: Jangan cache agar data selalu real-time
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── 6. HEADER KEAMANAN & KONEKSI KLIEN ─────────────────────────────────────────
<IfModule mod_headers.c>
    # Mencegah MIME sniffing & clickjacking
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Menjaga koneksi tetap hidup untuk throughput tinggi
    Header set Connection "keep-alive"
</IfModule>
